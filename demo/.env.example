# ────────────────────────────────────────────────────────
# SupplyWatch — Harness SCS Demo Environment Variables
# ────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values:
#   cp demo/.env.example .env
#
# These variables are required by the demo helper scripts
# (trigger-pipeline.sh, etc.) and referenced in pipeline YAML.
# ────────────────────────────────────────────────────────

# ── Harness Platform ────────────────────────────────────
HARNESS_API_KEY=pat.xxxxx.xxxxxx.xxxxxxxxxxxxxxxx
HARNESS_ACCOUNT_ID=your_account_id
HARNESS_ORG=default
HARNESS_PROJECT=scs_demo
HARNESS_BASE_URL=https://app.harness.io

# ── Docker Registry ─────────────────────────────────────
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your_dockerhub_username
DOCKER_PASSWORD=your_dockerhub_password

# Image paths (used in pipeline input sets)
BACKEND_IMAGE=your_dockerhub_username/supplywatch-backend
FRONTEND_IMAGE=your_dockerhub_username/supplywatch-frontend
NOTIFICATION_IMAGE=your_dockerhub_username/supplywatch-notification

# ── Cosign ──────────────────────────────────────────────
# Paths to local Cosign key files (for verify-attestation.sh)
COSIGN_PUBLIC_KEY=./cosign/cosign.pub
COSIGN_PRIVATE_KEY=./cosign/cosign.key
COSIGN_PASSWORD=your_cosign_key_passphrase

# ── Kubernetes (for CD pipeline) ────────────────────────
K8S_CLUSTER_NAME=your_k8s_cluster
K8S_NAMESPACE_DEV=supplywatch-dev
K8S_NAMESPACE_STAGING=supplywatch-staging
K8S_NAMESPACE_PROD=supplywatch-prod

# ── Jira Integration (optional) ────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_PROJECT_KEY=SCS
JIRA_EMAIL=your_email@company.com
JIRA_API_TOKEN=your_jira_api_token

# ── Slack Notifications (optional) ─────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
